{
  "name": "lifion-kinesis",
  "version": "1.4.0",
  "description": "Lifion client for Amazon Kinesis Data streams",
  "keywords": [
    "adp",
    "amazon",
    "api",
    "aws",
    "big data",
    "client",
    "core",
    "kinesis",
    "lifion"
  ],
  "author": "Edgardo Avilés <Edgardo.Aviles@ADP.com>",
  "maintainers": [
    "Bryan Oemler <Bryan.Oemler@ADP.com>",
    "Edgardo Avilés <Edgardo.Aviles@ADP.com>",
    "Jenny Eckstein <Jenny.Eckstein@ADP.com>"
  ],
  "contributors": [
    "Chen Doron <Chen.Doron@ADP.com>",
    "Simon Gellis <Simon.Gellis@ADP.com>",
    "Mackenzie Turner <turner.mackenzie.m@gmail.com>",
    "Zaid Masud <Zaid.Masud@ADP.com>"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lifion/lifion-kinesis.git"
  },
  "bugs": {
    "url": "https://github.com/lifion/lifion-kinesis/issues"
  },
  "homepage": "https://github.com/lifion/lifion-kinesis#readme",
  "main": "lib/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build-docs": "jsdoc2md -t ./templates/README.hbs ./lib/*.js > ./README.md && git add ./README.md",
    "build-docs-watch": "npm-watch build-docs",
    "eslint": "eslint .",
    "format": "prettier --write '**/*.{md,js,json}' '!coverage/**/*.{js,json}'",
    "prepare": "husky",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable",
    "test": "vitest run -c vitest.unit.config.js --coverage",
    "test:integration": "vitest run -c vitest.integration.config.js",
    "test:smoke": "vitest run -c vitest.smoke.config.js",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "dependencies": {
    "async-retry": "^1.3.3",
    "aws-sdk": "^2.1693.0",
    "aws4": "^1.13.2",
    "fast-deep-equal": "^3.1.3",
    "got": "^15.0.5",
    "is-retry-allowed": "^3.0.0",
    "lifion-aws-event-stream": "^1.0.7",
    "lru-cache": "^11.5.1",
    "lzutf8": "^0.6.3",
    "project-name": "^1.0.0",
    "protobufjs": "^8.5.0",
    "short-uuid": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@eslint/json": "^2.0.0",
    "@smithy/eventstream-codec": "^4.3.6",
    "@smithy/util-utf8": "^4.3.6",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/eslint-plugin": "^1.6.19",
    "auto-changelog": "^2.4.0",
    "chalk": "^4.1.2",
    "chance": "^1.1.8",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-array-func": "^5.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.0.1",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "husky": "^9.1.7",
    "jsdoc-to-markdown": "^9.1.3",
    "lint-staged": "^12.3.5",
    "neostandard": "^0.13.0",
    "npm-watch": "^0.13.0",
    "pinst": "^3.0.0",
    "prettier": "^3.8.3",
    "semver": "^7.3.5",
    "vitest": "^4.1.8"
  },
  "watch": {
    "build-docs": {
      "patterns": [
        "lib"
      ]
    }
  }
}
